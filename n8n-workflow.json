      "name": "Extract Clean Email"
    },
    {
      "parameters": {
        "jsCode": "let body = $json.raw_body || \"\";\n\n// Remove HTML tags if any\nbody = body.replace(/<[^>]*>/g, \" \");\n\n// Remove quoted replies (common patterns)\nbody = body.replace(/On.*wrote:/gi, \"\");\nbody = body.replace(/From:.*$/gim, \"\");\nbody = body.replace(/Sent:.*$/gim, \"\");\nbody = body.replace(/To:.*$/gim, \"\");\nbody = body.replace(/Subject:.*$/gim, \"\");\n\n// Remove extra whitespace\nbody = body.replace(/\\s+/g, \" \").trim();\n\nreturn [{\n  json: {\n    from: $json.from,\n    subject: $json.subject,\n    clean_body: body\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        144
      ],
      "id": "a7c3a99b-5957-4bad-926a-ab8dcfee62b2",
      "name": "Clean Email Body"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Verified information you are allowed to use:\n{{ $json.verified_knowledge }}\n\n--------------------\n\nFrom: {{ $json.from }}\nSubject: {{ $json.subject }}\n\nEmail:\n{{ $json.clean_body }}\n",
        "options": {
          "systemMessage": "You are an AI decision engine for automated email responses.\n\nYour task:\n1. Classify the email intent.\n2. Decide how confident you are in replying.\n3. Generate a professional reply if appropriate.\n4. Explain your decision briefly.\n\nRules:\n- Do NOT mention AI or automation.\n- Be cautious with legal, financial, or sensitive topics.\n- If the email is unclear, lower the confidence.\n- Replies must be polite, concise, and human.\n- Do NOT include any signature, sign-off, name, company, or placeholders in the reply.\n- The reply must end without a closing phrase (no “Best regards”, “Sincerely”, etc.).\n- Match the tone to the sender’s enthusiasm level.\n- If the inquiry is clearly positive or curious, sound welcoming.\n- Do not sound overly promotional.\n- Never invent pricing, plans, features, policies, or timelines.\n- If exact information is not provided in the verified knowledge, you must say you cannot confirm and ask for clarification or redirect appropriately.\n\nReturn ONLY valid JSON in the following format:\n\n{\n  \"intent\": \"support | sales | general | spam | sensitive\",\n  \"confidence\": 0.00,\n  \"reply\": \"email reply text\",\n  \"reason\": \"short explanation of the decision\"\n}\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        1120,
